# =============================================================================
# Agoreum, Environment Variable Reference
# Copy to .env and fill in real values. NEVER commit the real .env file.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL / DigitalOcean Managed DB) -------------------------
DATABASE_URL=postgresql+asyncpg://user:password@host:25060/agoreum?sslmode=require
DATABASE_URL_SYNC=postgresql://user:password@host:25060/agoreum?sslmode=require
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=agoreum
# Connection pool sizing. Tune DB_POOL_SIZE against the managed database's
# connection limit divided by the number of API replicas.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Logs every SQL statement. Never enable in production.
DB_ECHO=false

# --- Redis (cache / background jobs) ------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Auth / Sessions (Sign-In With Ethereum) ----------------------------------
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
SIWE_SESSION_SECRET=
# Must match the host the browser sees, or SIWE signature verification fails.
SIWE_DOMAIN=agoreum.xyz
SIWE_STATEMENT=Sign in to Agoreum. This request will not trigger a blockchain transaction or cost any gas.
SIWE_NONCE_TTL_SECONDS=600

# --- DigitalOcean --------------------------------------------------------------
DIGITAL_OCEAN_API_KEY=
DIGITAL_OCEAN_PROJECT_ID=
DIGITAL_OCEAN_DROPLET_PASSWORD=

# --- GitHub (CI/CD) --------------------------------------------------------------
GITHUB_ACCESS_TOKEN=

# --- Cloudflare (DNS / CDN / WAF / R2) ------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_URL=

# --- Blockchain (Base via Alchemy) ------------------------------------------
ALCHEMY_API_KEY=
# Complete RPC endpoints including the key, as Alchemy issues them. The active
# one is selected by CHAIN_ID, so there is no second place to keep in sync.
ALCHEMY_BASE_URL_MAINNET=
ALCHEMY_BASE_URL_SEPOLIA=
# 8453 = Base mainnet, 84532 = Base Sepolia. This one value also selects the
# USDC address and block explorer, so a testnet build cannot accidentally point
# at a mainnet token.
CHAIN_ID=84532
# Confirmations before an on-chain event is treated as settled.
CHAIN_CONFIRMATIONS=5
ESCROW_CONTRACT_ADDRESS=
# The on-chain USDC subscription contract, indexed like the escrow. Left empty,
# the subscription indexer idles and the subscribe endpoints report unconfigured.
# Set both from the deployment receipt once deployed to testnet.
SUBSCRIPTIONS_CONTRACT_ADDRESS=
SUBSCRIPTIONS_DEPLOY_BLOCK=
# Roles for the subscription contract deployment (testnet). On mainnet these must
# be separated and behind a multisig, exactly like the escrow roles.
SUBSCRIPTIONS_ADMIN_ADDRESS=
SUBSCRIPTIONS_TREASURY_ADDRESS=
# The block the escrow contract was deployed in, take it from the deployment
# receipt. The indexer starts here the first time it runs against a given
# contract; there is nothing to find before it, and without this value the only
# safe default is genesis, which is not a viable scan on a live chain.
ESCROW_DEPLOY_BLOCK=

# --- Contract deployment (only needed when deploying) -----------------------
# Private key of the deploying account. Required by `forge script`; the
# application itself never reads or needs this, and never signs anything.
#
# For MAINNET, prefer not to set this at all and sign with hardware instead:
#   forge script script/DeployEscrow.s.sol --rpc-url base --broadcast --ledger
# The escrow constructor grants every role to the `admin` argument and never to
# msg.sender, so the deploying account ends up with no privileges whatsoever. It
# only needs enough ETH for gas, and it should be a throwaway either way. A key
# that sits in a file on a workstation is readable by every process running as
# that user, and it must not be the key that also governs the contract.
DEPLOYER_PRIVATE_KEY=
#
# Roles granted at deployment. On mainnet the deploy script REQUIRES these to be
# three distinct addresses and reverts with RolesNotSeparated otherwise. That
# check runs once, at deployment: DEFAULT_ADMIN can grant itself ARBITER_ROLE
# afterwards, so separation is an operational commitment the contract does not
# enforce for you (see test/AgoreumEscrow.governance.t.sol).
#
# ESCROW_ADMIN_ADDRESS holds DEFAULT_ADMIN_ROLE and GOVERNOR_ROLE: it can change
#   the fee up to the 10% ceiling, repoint the fee recipient, pause new escrows,
#   and grant or revoke any role. This must be a Safe multisig on Base, not an
#   EOA. Nothing in the contract checks that it has code, so an EOA passes the
#   separation gate silently.
# ESCROW_ARBITER_ADDRESS settles disputed escrows, splitting between that
#   escrow's own buyer and provider. It cannot raise a dispute and cannot touch
#   an undisputed escrow. An operational key or a smaller multisig is fine.
# ESCROW_FEE_RECIPIENT receives the fee. Read from live storage at payout time,
#   so changing it also redirects the fee on escrows that are already funded.
#   If the settlement token ever blacklists this address, release() reverts for
#   every escrow until it is repointed.
ESCROW_ADMIN_ADDRESS=
ESCROW_ARBITER_ADDRESS=
ESCROW_FEE_RECIPIENT=
ESCROW_FEE_BPS=250
#
# Mainnet is refused unless this is set deliberately. Leave it OUT of this file
# and out of .env: scope it to the single command that deploys, so the decision
# is visible in shell history rather than sitting somewhere nobody reviews.
#   ALLOW_MAINNET_DEPLOY=true forge script ... --rpc-url base --broadcast --ledger
# ALLOW_MAINNET_DEPLOY=true
# Required to verify the deployed source on Basescan.
BASESCAN_API_KEY=
# Obtain from https://cloud.reown.com. Without it the WalletConnect connector is
# omitted from the UI rather than shown as a button that cannot work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_COINBASE_APP_NAME=Agoreum
# Browser-side RPC endpoints. Optional: wagmi falls back to Base's public RPC,
# which is fine for development but rate-limited under real traffic.
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# --- Email (Resend) --------------------------------------------------------------
RESEND_API_KEY=
# Master switch for outbound email. Leave false anywhere that is not production:
# with it off, deliveries are still recorded (as suppressed, with the reason) so
# the intent is visible without anyone actually being contacted.
EMAIL_SENDING_ENABLED=false
EMAIL_FROM=support@agoreum.xyz
SUPPORT_EMAIL=support@agoreum.xyz
CONTACT_EMAIL=agoreum@gmail.com

# --- Webhooks ------------------------------------------------------------------
# Master switch for outbound webhook HTTP, mirroring EMAIL_SENDING_ENABLED. Off
# by default: until it is true, the delivery worker records due deliveries as
# suppressed rather than POSTing to any user-configured URL.
WEBHOOK_DELIVERY_ENABLED=false
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_TIMEOUT_SECONDS=10

# --- Messaging bots ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Monitoring / observability ------------------------------------------------
SENTRY_DSN=
# Chat id the uptime/error monitor sends alerts to. A bot cannot message a chat
# that has not messaged it first, so send any message to the bot once, then read
# the id from getUpdates. Left empty, the monitor runs but stays silent.
TELEGRAM_CHAT_ID=
LOG_LEVEL=info

# --- Rate limiting / security ------------------------------------------------
# Defaults to true in code, so a deployment that never sets this is still
# protected. Turned off only in local development and CI, where hundreds of
# sign-ins from one address would throttle the run itself.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=https://agoreum.xyz,https://www.agoreum.xyz

# --- Social / public presence (used in metadata & footer links) ---------------
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# --- Search-engine verification (optional) -------------------------------------
# Ownership tokens for Google Search Console and Bing Webmaster Tools. Each vendor
# gives you the token when you choose the "HTML tag" verification method; paste the
# value from content="..." here. They render as public meta tags in the page head,
# baked in at build time, so a rebuild is needed after setting them.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Creator analytics (optional) ----------------------------------------------
# View counts come from the self-hosted Umami database directly, so no Umami API
# token is needed. Point these at the same Umami database and website the site
# already uses. When unset, view and conversion metrics report as unavailable.
UMAMI_DATABASE_URL=
UMAMI_WEBSITE_ID=
