# =============================================================================
# Agoreum — Environment Variable Reference
# Copy to .env and fill in real values. NEVER commit the real .env file.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Database (PostgreSQL / DigitalOcean Managed DB) -------------------------
DATABASE_URL=postgresql+asyncpg://user:password@host:25060/agoreum?sslmode=require
DATABASE_URL_SYNC=postgresql://user:password@host:25060/agoreum?sslmode=require
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=agoreum

# --- Redis (cache / background jobs) ------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Auth / Sessions (Sign-In With Ethereum) ----------------------------------
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
SIWE_SESSION_SECRET=
SIWE_DOMAIN=agoreum.xyz

# --- DigitalOcean --------------------------------------------------------------
DIGITAL_OCEAN_API_KEY=
DIGITAL_OCEAN_PROJECT_ID=
DIGITAL_OCEAN_DROPLET_PASSWORD=

# --- GitHub (CI/CD) --------------------------------------------------------------
GITHUB_ACCESS_TOKEN=

# --- Cloudflare (DNS / CDN / WAF / R2) ------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_URL=

# --- Blockchain (Base via Alchemy) ------------------------------------------
ALCHEMY_API_KEY=
ALCHEMY_BASE_URL=https://base-mainnet.g.alchemy.com/v2/
ALCHEMY_BASE_SEPOLIA_URL=https://base-sepolia.g.alchemy.com/v2/
CHAIN_ID=8453
USDC_CONTRACT_ADDRESS_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
ESCROW_CONTRACT_ADDRESS=
DEPLOYER_PRIVATE_KEY=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_COINBASE_APP_NAME=Agoreum

# --- Email (Resend) --------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=support@agoreum.xyz
SUPPORT_EMAIL=support@agoreum.xyz
CONTACT_EMAIL=agoreum@gmail.com

# --- Messaging bots ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Monitoring / observability ------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info

# --- Rate limiting / security ------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=https://agoreum.xyz,https://www.agoreum.xyz

# --- Social / public presence (used in metadata & footer links) ---------------
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
