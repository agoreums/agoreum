# =============================================================================
# Agoreum .gitignore
# Secrets and environment files are NEVER committed. If in doubt, ignore it.
# =============================================================================

# --- Environment / secrets ---------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*secret*
*credentials*
!**/secrets.example.*
wallet.json
keystore/

# --- Node / frontend -----------------------------------------------------
node_modules/
.pnp
.pnp.js
.next/
out/
dist/
build/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts
coverage/
.eslintcache

# --- Python / backend -----------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# --- Solidity / smart contracts -------------------------------------------
artifacts/
cache/
typechain-types/
contracts/.openzeppelin/

# --- Databases / logs -------------------------------------------------------
*.sqlite3
*.sqlite
*.db
*.log
logs/
*.log.*

# --- Docker / infra -----------------------------------------------------
*.pid
.docker/
docker-compose.override.yml

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# --- Misc -------------------------------------------------------------------
*.tmp
*.bak
.cache/

# --- Foundry / chain artefacts ------------------------------------------------
contracts/out/
contracts/cache/
contracts/broadcast/
# Local Anvil fixture, regenerated by scripts/anvil_fixture.py
apps/api/tests/anvil_fixture.json

# --- TLS material -------------------------------------------------------------
# A private key in version control is compromised the moment the repo is cloned.
infra/nginx/certs/
*.crt

# A CA certificate is not a secret. It is the public half that clients use to
# verify a server, and it has to travel with the code that does the verifying.
# The blanket *.crt rule above exists to stop origin certificates and private
# keys being committed, which is right; this one file is the exception.
!infra/certs/digitalocean-db-ca.crt

# Cloudflare Worker local state and credentials. .cf-auth carries an API token
# and .dev.vars carries the Telegram secrets for local runs; neither belongs in
# version control, and the repository is public.
infra/uptime-worker/.cf-auth
infra/uptime-worker/.dev.vars
infra/uptime-worker/.wrangler/
infra/uptime-worker/node_modules/

# Redis writes a snapshot wherever it is started from.
dump.rdb
